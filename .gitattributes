# Keep source and automation files reproducible across Windows, macOS, Linux, and CI.
* text=auto

*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.cpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.py text eol=lf

gradlew text eol=lf
gradlew.bat text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.apk binary
*.aab binary
*.jar binary
*.so binary

# Keep pinned vendor files byte-for-byte compatible with their SHA-256 manifest.
app/src/main/cpp/vendor/** -text
